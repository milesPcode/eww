cat > style.css << 'ENDOFFILE'
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--green:#00ff41;--green-dim:#1a6a1a;--green-mid:#44aa44;--green-border:#1a3a1a;--bg-base:#040d04;--bg-dark:#030b03;--bg-bar:#060f06;--red:#ff3333;--red-dark:#1a0505;--red-border:#441111;--amber:#ffaa00;--font-mono:'Courier New',Courier,monospace}
html,body{height:100%;background:var(--bg-base);color:var(--green);font-family:var(--font-mono);font-size:13px;overflow:hidden}
.titlebar{display:flex;align-items:center;justify-content:space-between;background:#050e05;border-bottom:1px solid var(--green-border);padding:0 12px;height:36px;flex-shrink:0}
.titlebar-left{display:flex;align-items:center;gap:10px}
.title-logo{font-size:16px;font-weight:900;letter-spacing:4px;color:var(--green);text-transform:uppercase}
.title-sub{font-size:13px;font-weight:700;letter-spacing:3px;color:var(--green-mid);text-transform:uppercase}
.title-badge{background:#001a00;border:1px solid #007700;color:var(--green);font-size:10px;font-weight:700;letter-spacing:2px;padding:2px 8px;border-radius:2px}
.title-danger{background:var(--red-dark);border:1px solid var(--red-border);color:var(--red);font-size:10px;font-weight:700;letter-spacing:1.5px;padding:2px 8px;border-radius:2px}
.title-stat{font-size:11px;color:var(--red);letter-spacing:1px}
.title-stat.attached{color:var(--green)}
.main-layout{display:flex;height:calc(100vh - 36px);overflow:hidden}
.sidebar{width:148px;background:var(--bg-base);border-right:1px solid var(--green-border);display:flex;flex-direction:column;padding:8px 0;flex-shrink:0;overflow-y:auto}
.sidebar-section{font-size:9px;color:#1a5a1a;letter-spacing:2px;text-transform:uppercase;padding:8px 10px 4px;font-weight:700}
.sidebar-item{display:flex;align-items:center;gap:7px;padding:5px 10px;font-size:11px;color:#2a7a2a;cursor:pointer;border-left:2px solid transparent}
.sidebar-item::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--green);flex-shrink:0}
.sidebar-item.dim::before{background:#1a4a1a}
.sidebar-item.active{color:var(--green);background:rgba(0,255,65,0.05);border-left:2px solid var(--green)}
.sidebar-item:hover:not(.active){color:var(--green-mid);background:rgba(0,255,65,0.03)}
.center-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;background:var(--bg-dark)}
.tab-bar{display:flex;background:var(--bg-bar);border-bottom:1px solid var(--green-border);padding:0 8px;gap:2px;flex-shrink:0}
.tab{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#2a6a2a;padding:6px 14px;cursor:pointer;border-bottom:2px solid transparent}
.tab.active{color:var(--green);border-bottom:2px solid var(--green)}
.tab:hover:not(.active){color:var(--green-mid)}
.tab.tab-add{color:#1a4a1a;font-size:15px;padding:4px 10px}
#editor-container{flex:1;min-height:0;border-bottom:1px solid var(--green-border);position:relative}
#editor-container::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:420px;height:420px;background-image:url('bg.jpg');background-size:contain;background-repeat:no-repeat;background-position:center;opacity:0.15;z-index:10;pointer-events:none}
.toolbar{display:flex;align-items:center;gap:6px;background:var(--bg-bar);border-bottom:1px solid var(--green-border);padding:6px 10px;flex-shrink:0;flex-wrap:wrap}
.port-label{font-size:10px;color:var(--green-dim);letter-spacing:2px}
select{background:var(--bg-dark);color:var(--green);border:1px solid var(--green-border);border-radius:3px;padding:3px 8px;font-family:var(--font-mono);font-size:11px;cursor:pointer;outline:none}
.btn{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border:none;border-radius:3px;padding:5px 13px;cursor:pointer;transition:opacity 0.15s}
.btn:hover{opacity:0.8}.btn:active{transform:scale(0.97)}
.btn-exec{background:#003300;color:var(--green);border:1px solid #007700}
.btn-inject{background:#001a00;color:var(--green-mid);border:1px solid #004400}
.btn-dim{background:#0a150a;color:#2a7a2a;border:1px solid var(--green-border)}
.toolbar-spacer{flex:1}
.not-attached{font-size:10px;background:var(--red-dark);border:1px solid var(--red-border);color:var(--red);padding:2px 8px;border-radius:2px;letter-spacing:1px}
.not-attached.ok{background:#001a00;border:1px solid #007700;color:var(--green)}
.console-header{display:flex;align-items:center;justify-content:space-between;background:#050e05;border-bottom:1px solid var(--green-border);padding:3px 10px;font-size:10px;color:var(--green-dim);letter-spacing:2px;text-transform:uppercase;flex-shrink:0}
.btn-tiny{background:transparent;border:1px solid var(--green-border);color:#2a6a2a;font-size:10px;padding:1px 8px;border-radius:2px;cursor:pointer}
.btn-tiny:hover{color:var(--green)}
.console-output{height:130px;overflow-y:auto;background:var(--bg-dark);padding:8px 12px;font-size:12px;line-height:1.6;flex-shrink:0}
.console-output::-webkit-scrollbar{width:4px}.console-output::-webkit-scrollbar-thumb{background:#0f3a0f;border-radius:2px}
.log-info{color:var(--green)}.log-success{color:#44ff44}.log-error{color:var(--red)}.log-warn{color:var(--amber)}.log-muted{color:#2a7a2a}
ENDOFFILE

cat > script.js << 'ENDOFFILE'
const BACKEND_URL='http://localhost:3000';
require.config({paths:{vs:'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs'}});
let editor;
require(['vs/editor/editor.main'],function(){
  editor=monaco.editor.create(document.getElementById('editor-container'),{
    value:'-- RAT Executor v10.0\n-- Write your Lua script here\n\nprint("Hello from RAT Executor!")\n',
    language:'lua',theme:'vs-dark',fontSize:13,
    fontFamily:'"Courier New",Courier,monospace',
    minimap:{enabled:false},scrollBeyondLastLine:false,
    lineNumbers:'on',automaticLayout:true,padding:{top:10}
  });
  monaco.editor.defineTheme('rat-theme',{
    base:'vs-dark',inherit:true,
    rules:[
      {token:'comment',foreground:'1a6a1a'},
      {token:'string',foreground:'44cc44'},
      {token:'keyword',foreground:'00ff41'},
      {token:'number',foreground:'aaff88'},
      {token:'',foreground:'00ee33'}
    ],
    colors:{
      'editor.background':'#030b03','editor.foreground':'#00ff41',
      'editor.lineHighlightBackground':'#0a1f0a',
      'editorCursor.foreground':'#00ff41',
      'editorLineNumber.foreground':'#1a4a1a',
      'editor.selectionBackground':'#003300'
    }
  });
  monaco.editor.setTheme('rat-theme');
  log('Editor ready.','muted');
});
function log(message,type){
  type=type||'info';
  const output=document.getElementById('console-output');
  const line=document.createElement('div');
  const now=new Date().toLocaleTimeString('en-US',{hour12:false});
  line.className='log-'+type;
  line.textContent='['+now+'] '+message;
  output.appendChild(line);
  output.scrollTop=output.scrollHeight;
}
function setAttachStatus(attached,label){
  const badge=document.getElementById('attach-badge');
  const status=document.getElementById('connection-status');
  badge.textContent=label;
  if(attached){badge.classList.add('ok');status.textContent='● '+label;status.classList.add('attached');}
  else{badge.classList.remove('ok');status.textContent='● '+label;status.classList.remove('attached');}
}
document.getElementById('btn-execute').addEventListener('click',async function(){
  if(!editor){log('Editor not ready.','warn');return;}
  const script=editor.getValue().trim();
  if(!script){log('Editor is empty.','warn');return;}
  const port=document.getElementById('port-select').value;
  log('Sending to port '+port+'...','info');
  setAttachStatus(false,'SENDING...');
  try{
    const res=await fetch(BACKEND_URL+'/execute',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({script:script,port:port})
    });
    const data=await res.json();
    if(data.success){log('SUCCESS on port '+data.port+': '+data.message,'success');setAttachStatus(true,'ATTACHED :'+data.port);}
    else{log('FAILED: '+data.message,'error');setAttachStatus(false,'NOT ATTACHED');}
  }catch(err){
    log('Cannot reach backend. '+err.message,'error');
    setAttachStatus(false,'NOT ATTACHED');
  }
});
document.getElementById('btn-inject').addEventListener('click',function(){document.getElementById('btn-execute').click();});
document.getElementById('btn-clear').addEventListener('click',function(){if(editor){editor.setValue('');log('Cleared.','muted');}});
document.getElementById('btn-clear-console').addEventListener('click',function(){document.getElementById('console-output').innerHTML='';});
document.getElementById('btn-save').addEventListener('click',function(){
  if(!editor)return;
  const blob=new Blob([editor.getValue()],{type:'text/plain'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='script.lua';a.click();
  log('Saved as script.lua','success');
});
document.getElementById('btn-open').addEventListener('click',function(){
  const input=document.createElement('input');input.type='file';input.accept='.lua,.txt';
  input.onchange=function(e){
    const file=e.target.files[0];if(!file||!editor)return;
    const reader=new FileReader();
    reader.onload=function(ev){editor.setValue(ev.target.result);log('Loaded: '+file.name,'success');};
    reader.readAsText(file);
  };
  input.click();
});
document.querySelectorAll('.tab').forEach(function(t){t.addEventListener('click',function(){document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('active');});t.classList.add('active');});});
document.querySelectorAll('.sidebar-item').forEach(function(i){i.addEventListener('click',function(){document.querySelectorAll('.sidebar-item').forEach(function(x){x.classList.remove('active');});i.classList.add('active');});});
ENDOFFILE

