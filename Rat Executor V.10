cat > main.js << 'ENDOFFILE'
const { app, BrowserWindow } = require('electron');
const path = require('path');
const { fork, exec } = require('child_process');
let mainWindow, backendProcess;
function startBackend() {
  backendProcess = fork(path.join(__dirname, 'server.js'), [], { silent: true });
  backendProcess.stdout.on('data', function(d) { console.log('[backend]', d.toString()); });
  backendProcess.stderr.on('data', function(d) { console.error('[backend error]', d.toString()); });
}
function startOpiumware() {
  exec('open -a /Applications/Opiumware.app', function(err) {
    if (err) console.error('Failed to launch Opiumware:', err.message);
    else console.log('Opiumware launched');
  });
  setTimeout(function() {
    exec("osascript -e 'tell application \"Opiumware\" to set visible to false'", function(err) {
      if (!err) console.log('Opiumware hidden');
    });
  }, 3000);
}
function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1100, height: 720,
    minWidth: 800, minHeight: 550,
    title: 'RAT Executor',
    backgroundColor: '#030b03',
    titleBarStyle: 'hiddenInset',
    webPreferences: { nodeIntegration: false, contextIsolation: true }
  });
  mainWindow.setMenuBarVisibility(false);
  mainWindow.loadFile('index.html');
  mainWindow.on('closed', function() { mainWindow = null; });
}
app.whenReady().then(function() {
  startOpiumware();
  startBackend();
  setTimeout(createWindow, 2000);
  app.on('activate', function() {
    if (BrowserWindow.getAllWindows().length === 0) createWindow();
  });
});
app.on('window-all-closed', function() {
  if (backendProcess) backendProcess.kill();
  exec("osascript -e 'quit app \"Opiumware\"'");
  app.quit();
});
app.on('before-quit', function() {
  if (backendProcess) backendProcess.kill();
  exec("osascript -e 'quit app \"Opiumware\"'");
});
ENDOFFILE

cat > server.js << 'ENDOFFILE'
const Express = require("express");
const Net = require("net");
const Zlib = require("zlib");
const App = Express();
App.use(Express.json());
App.use(function(req,res,next){
  res.setHeader("Access-Control-Allow-Origin","*");
  res.setHeader("Access-Control-Allow-Headers","Content-Type");
  res.setHeader("Access-Control-Allow-Methods","POST,GET,OPTIONS");
  if(req.method==="OPTIONS") return res.sendStatus(200);
  next();
});
async function execute(Code,Port){
  const Ports=["8392","8393","8394","8395","8396","8397"];
  let ConnectedPort=null,Stream=null;
  for(const P of(Port==="ALL"?Ports:[Port])){
    try{
      Stream=await new Promise(function(Resolve,Reject){
        const Socket=Net.createConnection({host:"127.0.0.1",port:parseInt(P)},function(){Resolve(Socket);});
        Socket.on("error",Reject);
      });
      ConnectedPort=P;
      break;
    }catch(Err){ console.log("Failed port "+P+": "+Err.message); }
  }
  if(!Stream) return {success:false,message:"Failed to connect on all ports"};
  const prefixed="OpiumwareScript "+Code;
  try{
    await new Promise(function(Resolve,Reject){
      Zlib.deflate(Buffer.from(prefixed,"utf8"),function(Err,Compressed){
        if(Err) return Reject(Err);
        Stream.write(Compressed,function(WriteErr){
          if(WriteErr) return Reject(WriteErr);
          console.log("Sent "+Compressed.length+" bytes to port "+ConnectedPort);
          Resolve();
        });
      });
    });
  }catch(Err){
    Stream.destroy();
    return {success:false,message:"Error: "+Err.message};
  }
  Stream.end();
  return {success:true,port:ConnectedPort,message:"Connected on port: "+ConnectedPort};
}
App.post("/execute",async function(req,res){
  const script=req.body.script,port=req.body.port;
  if(!script) return res.json({success:false,message:"No script provided"});
  res.json(await execute(script,port||"ALL"));
});
App.get("/ping",function(req,res){ res.json({status:"ok"}); });
App.listen(3000,function(){ console.log("Backend running on port 3000"); });
ENDOFFILE

