-- SERVICES
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

-- PLAYER
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- DASH SETTINGS
local dashing = false
local dashCooldown = false
local DASH_DISTANCE = 50
local DASH_TIME = 0.15
local COOLDOWN_TIME = 1

-- BLUR
local blur = Instance.new("BlurEffect")
blur.Size = 0
blur.Parent = Lighting

-- DASH COOLDOWN BAR
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "DashUI"
screenGui.ResetOnSpawn = false

local barBackground = Instance.new("Frame", screenGui)
barBackground.Size = UDim2.new(0, 200, 0, 20)
barBackground.Position = UDim2.new(0.5, -100, 0.9, 0)
barBackground.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

local cooldownBar = Instance.new("Frame", barBackground)
cooldownBar.Size = UDim2.new(1, 0, 1, 0)
cooldownBar.BackgroundColor3 = Color3.fromRGB(0, 170, 255)

-- SETTINGS GUI
local settingsFrame = Instance.new("Frame", screenGui)
settingsFrame.Size = UDim2.new(0, 250, 0, 140)
settingsFrame.Position = UDim2.new(0.02, 0, 0.2, 0)
settingsFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
settingsFrame.BorderSizePixel = 0

local title = Instance.new("TextLabel", settingsFrame)
title.Size = UDim2.new(1, 0, 0, 25)
title.Text = "Dash Settings"
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundTransparency = 1
title.Font = Enum.Font.SourceSansBold
title.TextSize = 20

-- FUNCTION TO CREATE SLIDER + LABEL
local function createSetting(name, yPos, minVal, maxVal, getVal, setVal)
	local label = Instance.new("TextLabel", settingsFrame)
	label.Position = UDim2.new(0, 10, 0, yPos)
	label.Size = UDim2.new(0, 100, 0, 20)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = name
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14

	local inputBox = Instance.new("TextBox", settingsFrame)
	inputBox.Position = UDim2.new(0, 120, 0, yPos)
	inputBox.Size = UDim2.new(0, 100, 0, 20)
	inputBox.Text = tostring(getVal())
	inputBox.Font = Enum.Font.SourceSans
	inputBox.TextSize = 14
	inputBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	inputBox.TextColor3 = Color3.new(1, 1, 1)
	inputBox.ClearTextOnFocus = false

	inputBox.FocusLost:Connect(function()
		local value = tonumber(inputBox.Text)
		if value then
			value = math.clamp(value, minVal, maxVal)
			setVal(value)
			inputBox.Text = tostring(value)
		else
			inputBox.Text = tostring(getVal())
		end
	end)
end

-- BUILD SLIDERS
createSetting("Speed", 30, 10, 200,
	function() return DASH_DISTANCE end,
	function(val) DASH_DISTANCE = val end
)

createSetting("Time", 60, 0.05, 1,
	function() return DASH_TIME end,
	function(val) DASH_TIME = val end
)

createSetting("Cooldown", 90, 0.1, 5,
	function() return COOLDOWN_TIME end,
	function(val) COOLDOWN_TIME = val end
)

-- TRAIL FUNCTION
local function addTrail()
	local trail = Instance.new("Trail")
	trail.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 0))
	}
	trail.Lifetime = 0.2
	trail.MinLength = 0.1
	trail.WidthScale = NumberSequence.new(1)

	local a0 = Instance.new("Attachment", humanoidRootPart)
	local a1 = Instance.new("Attachment", humanoidRootPart)
	a0.Position = Vector3.new(0, 1, 0)
	a1.Position = Vector3.new(0, -1, 0)

	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Parent = humanoidRootPart
	return trail
end

-- DASH FUNCTION
local function dash()
	if dashing or dashCooldown then return end
	dashing = true
	dashCooldown = true

	blur.Size = 25
	local trail = addTrail()

	cooldownBar.Size = UDim2.new(0, 0, 1, 0)
	TweenService:Create(cooldownBar, TweenInfo.new(COOLDOWN_TIME), {Size = UDim2.new(1, 0, 1, 0)}):Play()

	local direction = humanoidRootPart.CFrame.LookVector
	local startTime = tick()

	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = tick() - startTime
		if elapsed >= DASH_TIME then
			humanoidRootPart.Velocity = Vector3.zero
			connection:Disconnect()
			dashing = false
			blur.Size = 0
			if trail then trail:Destroy() end

			task.delay(COOLDOWN_TIME, function()
				dashCooldown = false
			end)
			return
		end
		humanoidRootPart.Velocity = direction * (DASH_DISTANCE / DASH_TIME)
	end)
end

-- KEYBIND
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.F then
		dash()
	end
end)
